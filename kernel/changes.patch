-func generateGUIDByDeviceName(name string) *windows.GUID {
-	hash := md5.New()
-	hash.Write([]byte("wintun"))
-	hash.Write([]byte(name))
-	sum := hash.Sum(nil)
-	return (*windows.GUID)(unsafe.Pointer(&sum[0]))
-}
